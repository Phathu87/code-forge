# Local development uses SQLite unless DATABASE_URL is supplied.
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/codeforge.sqlite
# Hosted database (keep the real URI private):
# DATABASE_URL=postgresql://...
# Free Render hosting uses the Brevo HTTPS API, not SMTP.
# BREVO_API_KEY=...
# MAIL_FROM=verified-sender@example.com
# Set false until email delivery has been tested.
# REGISTRATION_ENABLED=false
# SQLite-only optional backups:
# BACKUP_DIRECTORY=.data/backups
# BACKUP_RETENTION_DAYS=7
# Production preview only: comma-separated invited email addresses.
# REGISTRATION_ALLOWLIST=...

# Internal assessment QA only; requires reviewer provisioning and a grading service.
LEARNING_CORE_ENABLED=false
